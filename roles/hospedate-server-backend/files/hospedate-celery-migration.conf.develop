[program:hospedate-celery-migration]
command=/home/hospedate/hospedate-backend/venv/bin/celery -A config worker -Q migration --concurrency=2 --prefetch-multiplier=1 --loglevel=info
directory=/home/hospedate/hospedate-backend
user=hospedate
autostart=true
autorestart=true
redirect_stderr=true
stdout_logfile=/home/hospedate/hospedate-backend/logs/celery-migration.log
environment=DJANGO_ENV="develop",DJANGO_SETTINGS_MODULE="config.django.development",GOOGLE_APPLICATION_CREDENTIALS="/etc/gcp/firebase-sa.json",GOOGLE_CLOUD_PROJECT="hospedate-dev",GOOGLE_CLOUD_QUOTA_PROJECT="hospedate-dev",AWS_REGION="us-east-2"

