[program:hospedate-celery-populate-availability]
command=/home/hospedate/hospedate-backend/venv/bin/celery -A config worker -Q populate_availability --loglevel=info --concurrency=1
directory=/home/hospedate/hospedate-backend
user=hospedate
autostart=true
autorestart=true
redirect_stderr=true
stdout_logfile=/home/hospedate/hospedate-backend/logs/celery-populate-availability.log
environment=DJANGO_ENV="production",DJANGO_SETTINGS_MODULE="config.django.production",GOOGLE_APPLICATION_CREDENTIALS="/etc/gcp/firebase-sa.json",GOOGLE_CLOUD_PROJECT="hospedate-production",GOOGLE_CLOUD_QUOTA_PROJECT="hospedate-prod",AWS_REGION="us-east-2"

