[program:hospedate-django]
command=/home/hospedate/hospedate-backend/venv/bin/gunicorn config.wsgi:application -c /home/hospedate/hospedate-backend/gunicorn.conf.py
directory=/home/hospedate/hospedate-backend
user=hospedate
autostart=true
autorestart=true
redirect_stderr=true
stdout_logfile=/home/hospedate/hospedate-backend/logs/django.log
environment=DJANGO_ENV="production",DJANGO_SETTINGS_MODULE="config.django.production",GOOGLE_APPLICATION_CREDENTIALS="/etc/gcp/firebase-sa.json",GOOGLE_CLOUD_PROJECT="hospedate-prod",GOOGLE_CLOUD_QUOTA_PROJECT="hospedate-prod",AWS_REGION="us-east-2"

